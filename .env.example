# Copier ce fichier en .env (jamais commité).
# URL du projet Supabase (Project settings > API)
VITE_SUPABASE_URL=
# Clé publique (anon / publishable). Jamais la clé service_role côté client.
VITE_SUPABASE_ANON_KEY=
# Mode démo local (données non synchronisées, aucun serveur). "true" pour forcer.
# Si VITE_SUPABASE_URL est vide, le mode démo est proposé automatiquement.
VITE_DEMO_MODE=false
